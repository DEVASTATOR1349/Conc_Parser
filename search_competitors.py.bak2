#!/usr/bin/env python3
"""
search_competitors.py — Мульти-клиентский поиск конкурентов.

Использование:
  # По профилю клиента (рекомендуется)
  python3 search_competitors.py --client nomos

  # Legacy mode (без профиля, из .env)
  python3 search_competitors.py

  # Сухой прогон
  python3 search_competitors.py --client nomos --dry-run

Источники (по наличию ключей):
  - Brave Search API
  - YouTube Data API v3
  - VK API (groups.search)
  - Apify Instagram (опционально, RESIDENTIAL proxy)

Факт-чекинг: L1/L2/L3
Результаты: Google Sheets + stdout
"""

import argparse
import html
import json
import os
import re
import sys
import time
from datetime import datetime
from urllib.parse import urlparse

import requests

# ── Подключаем свои модули ──
sys.path.insert(0, os.path.join(os.path.dirname(__file__), "src"))
from sheets import get_existing, write_results
from fact_check import verify_competitor
from client_loader import load_client, list_clients

# ── Токены из .env ──
BRAVE_API_KEY = os.getenv("BRAVE_API_KEY", "")
YT_KEY = os.getenv("YOUTUBE_API_KEY", "")
VK_KEY = os.getenv("VK_API_KEY", "")
APIFY_TOKEN = os.getenv("APIFY_API_TOKEN", "")
OPENROUTER_KEY = os.getenv("OPENROUTER_API_KEY", "")

# ── Факт-чекинг ──
FACT_CHECK_LEVEL2 = os.getenv("FACT_CHECK_LEVEL2", "true").lower() == "true"
FACT_CHECK_LEVEL3 = os.getenv("FACT_CHECK_LEVEL3", "false").lower() == "true"
FACT_CHECK_STRICT = os.getenv("FACT_CHECK_STRICT", "true").lower() == "true"


# ═══════════════════════════════════════════════════
#  УТИЛИТЫ
# ═══════════════════════════════════════════════════


def fmt_subs(n):
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    elif n >= 1_000:
        return f"{n // 1000}K"
    return str(n)


def is_relevant(title, desc, cfg):
    """Проверка релевантности по профилю клиента."""
    include = cfg.get("include_keywords", [])
    exclude = cfg.get("exclude_keywords", [])
    text = f"{title} {desc}".lower()
    for kw in exclude:
        if kw.lower() in text:
            return False
    if not include:
        return True  # если не заданы — пропускаем всё
    return any(w in text for w in include)


def classify_domain(domain):
    if "instagram" in domain:
        return "Прямой — косметолог/блогер"
    if any(d in domain for d in ("prodoctorov", "otzyv", "napopravku")):
        return "Отзовик — профиль клиники"
    return "Прямой — клиника/косметолог"


def dedup(items, key="name"):
    seen = {}
    for item in items:
        k = item[key].lower().strip()
        if k not in seen:
            seen[k] = item
    return list(seen.values())


def filter_with_factcheck(items, cfg):
    """Прогнать список через факт-чекинг."""
    passed = []
    failed = []

    for item in items:
        verdict, reason = verify_competitor(
            title=item.get("name", ""),
            desc=item.get("positioning", "") + " " + item.get("strengths", ""),
            url=item.get("links", ""),
            use_level2=FACT_CHECK_LEVEL2,
            use_level3=FACT_CHECK_LEVEL3,
            verbose=False,
        )

        item["fact_check"] = f"{verdict.upper()} — {reason}"

        if verdict == "pass":
            passed.append(item)
        elif verdict == "uncertain" and not FACT_CHECK_STRICT:
            passed.append(item)
        else:
            failed.append(item)

    return passed, failed


# ═══════════════════════════════════════════════════
#  ИСТОЧНИКИ
# ═══════════════════════════════════════════════════


def from_brave(cfg, existing_links, existing_names):
    """Поиск через Brave Search API."""
    if not BRAVE_API_KEY:
        print("  [Brave] Нет BRAVE_API_KEY — пропускаем")
        return []

    queries = cfg.get("queries_brave", [])
    if not queries:
        print("  [Brave] Нет поисковых запросов в профиле — пропускаем")
        return []

    found = []
    for query in queries:
        print(f"  [Brave] {query}", end="", flush=True)
        try:
            resp = requests.get(
                "https://api.search.brave.com/res/v1/web/search",
                params={"q": query, "count": 10, "country": "RU", "search_lang": "ru"},
                headers={
                    "Accept": "application/json",
                    "Accept-Encoding": "gzip",
                    "X-Subscription-Token": BRAVE_API_KEY,
                },
                timeout=15,
            )
            if resp.status_code != 200:
                print(f" -> {resp.status_code}")
                time.sleep(0.5)
                continue

            data = resp.json()
            n = 0
            results = []
            for grp in ("web", "news"):
                for item in data.get(grp, {}).get("results", []):
                    results.append(item)

            for item in results:
                title = html.unescape(item.get("title", "").strip())
                desc = html.unescape(
                    item.get("description") or item.get("snippet") or ""
                ).strip()
                link = item.get("url", "")

                if not title or not is_relevant(title, desc, cfg):
                    continue
                if title.lower() in existing_names:
                    continue
                if link.lower().rstrip("/") in existing_links:
                    continue

                domain = urlparse(link).netloc.lower()

                found.append({
                    "name": title,
                    "category": classify_domain(domain),
                    "links": link,
                    "subscribers": "—",
                    "positioning": desc[:300] if desc else "—",
                    "services": "—",
                    "price_segment": "—",
                    "strengths": f"Brave Search. {desc[:250]}".strip()[:300],
                    "weaknesses": "—",
                    "tov": "—",
                    "audience": "—",
                    "activity": "—",
                    "formats": "—",
                    "threat_level": "—",
                    "borrow": "—",
                    "conclusion": f"Найден Brave: {query}",
                })

                existing_links.add(link.lower().rstrip("/"))
                existing_names.add(title.lower())
                n += 1

            print(f" +{n}")
            time.sleep(0.3)
        except Exception as e:
            print(f" ERR: {e}")

    # Факт-чекинг
    if FACT_CHECK_LEVEL2 or FACT_CHECK_LEVEL3:
        before = len(found)
        found, failed = filter_with_factcheck(found, cfg)
        if failed:
            print(f"  [fact-check] отсеяно {len(failed)}/{before}: {', '.join(i['name'][:30] for i in failed[:5])}")
    else:
        found = dedup(found)

    return dedup(found)


def from_youtube(cfg, existing_links, existing_names):
    """Поиск через YouTube Data API v3."""
    if not YT_KEY:
        print("  [YouTube] Нет YOUTUBE_API_KEY — пропускаем")
        return []

    queries = cfg.get("queries_youtube", [])
    if not queries:
        print("  [YouTube] Нет запросов — пропускаем")
        return []

    found = []
    for query in queries:
        print(f"  [YouTube] {query}", end="", flush=True)
        try:
            resp = requests.get(
                "https://youtube.googleapis.com/youtube/v3/search",
                params={
                    "part": "snippet",
                    "q": query,
                    "type": "channel",
                    "maxResults": 10,
                    "relevanceLanguage": "ru",
                    "key": YT_KEY,
                },
                timeout=15,
            )
            if resp.status_code != 200:
                print(f" -> {resp.status_code}")
                continue

            n = 0
            for item in resp.json().get("items", []):
                s = item["snippet"]
                title = s.get("title", "").strip()
                cid = item["id"]["channelId"]
                desc = s.get("description", "").strip()

                if not is_relevant(title, desc, cfg):
                    continue
                if title.lower() in existing_names:
                    continue

                c_url = f"https://www.youtube.com/channel/{cid}"
                if c_url.lower() in existing_links:
                    continue

                # Подписчики и видео
                stats = {}
                try:
                    sr = requests.get(
                        "https://youtube.googleapis.com/youtube/v3/channels",
                        params={"part": "statistics", "id": cid, "key": YT_KEY},
                        timeout=10,
                    )
                    if sr.status_code == 200:
                        si = sr.json().get("items", [])
                        if si:
                            st = si[0].get("statistics", {})
                            stats = {
                                "subs": int(st.get("subscriberCount", 0)),
                                "videos": int(st.get("videoCount", 0)),
                            }
                except Exception:
                    pass

                ss = fmt_subs(stats.get("subs", 0)) if stats else "?"
                vc = stats.get("videos", 0) if stats else 0
                act = f"~{vc} видео" if vc else "—"
                strong = f"YouTube-канал"
                if ss != "?":
                    strong += f", {ss} подписчиков"
                strong += f". {desc[:200]}"

                found.append({
                    "name": title,
                    "category": "Прямой — клиника/косметолог",
                    "links": c_url,
                    "subscribers": f"{ss} (YouTube)" if ss != "?" else "—",
                    "positioning": desc[:250] if desc else "YouTube-канал",
                    "services": "Косметологические услуги",
                    "price_segment": "—",
                    "strengths": strong.strip()[:300],
                    "weaknesses": "—",
                    "tov": "—",
                    "audience": "Женщины 25–50",
                    "activity": act,
                    "formats": "YouTube",
                    "threat_level": "—",
                    "borrow": "—",
                    "conclusion": f"Найден YouTube: {query}",
                })

                existing_links.add(c_url.lower())
                existing_names.add(title.lower())
                n += 1

            print(f" +{n}")
            time.sleep(0.4)
        except Exception as e:
            print(f" ERR: {e}")

    # Факт-чекинг
    if FACT_CHECK_LEVEL2 or FACT_CHECK_LEVEL3:
        before = len(found)
        found, failed = filter_with_factcheck(found, cfg)
        if failed:
            print(f"  [fact-check] отсеяно {len(failed)}/{before}")
    else:
        found = dedup(found)

    return dedup(found)


def from_vk(cfg, existing_links, existing_names):
    """Поиск групп VK через newsfeed.search."""
    if not VK_KEY:
        print("  [VK] Нет VK_API_KEY — пропускаем")
        return []

    queries = cfg.get("queries_vk", [])
    if not queries:
        print("  [VK] Нет запросов — пропускаем")
        return []

    found = []
    api_url = "https://api.vk.com/method/"
    v = "5.199"

    for query in queries:
        print(f"  [VK] {query}", end="", flush=True)
        try:
            resp = requests.get(
                f"{api_url}newsfeed.search",
                params={
                    "q": query,
                    "count": 20,
                    "extended": 1,
                    "access_token": VK_KEY,
                    "v": v,
                },
                timeout=15,
            )
            if resp.status_code != 200:
                print(f" -> HTTP {resp.status_code}")
                time.sleep(0.5)
                continue

            data = resp.json()
            if "error" in data:
                print(f" -> VK error: {data['error'].get('error_msg', data['error'])}")
                time.sleep(0.5)
                continue

            groups = data.get("response", {}).get("groups", [])
            n = 0
            for g in groups:
                name = g.get("name", "").strip()
                screen_name = g.get("screen_name", "")
                gtype = g.get("type", "group")
                url = f"https://vk.com/{screen_name}" if screen_name else ""

                if not name:
                    continue
                if not is_relevant(name, "", cfg):
                    continue
                if name.lower() in existing_names:
                    continue
                if url and url.lower().rstrip("/") in existing_links:
                    continue

                found.append({
                    "name": name,
                    "category": "Прямой — клиника/косметолог (VK)",
                    "links": url or f"https://vk.com/club{g['id']}",
                    "subscribers": "—",
                    "positioning": "VK-сообщество",
                    "services": "—",
                    "price_segment": "—",
                    "strengths": f"VK-сообщество по теме. Найден по запросу: {query}",
                    "weaknesses": "—",
                    "tov": "—",
                    "audience": "—",
                    "activity": "—",
                    "formats": "VK (посты, видео)",
                    "threat_level": "—",
                    "borrow": "—",
                    "conclusion": f"Найден VK: {query}",
                })

                existing_links.add(url.lower().rstrip("/"))
                existing_names.add(name.lower())
                n += 1

            print(f" +{n}")
            time.sleep(0.5)
        except Exception as e:
            print(f" ERR: {e}")

    # VK: без L2 (нет страниц /uslugi), только L3 при наличии
    if FACT_CHECK_LEVEL3 and OPENROUTER_KEY:
        before = len(found)
        found, failed = filter_with_factcheck(found, cfg)
        if failed:
            print(f"  [fact-check L3] отсеяно {len(failed)}/{before}")
    else:
        found = dedup(found)

    return dedup(found)


def from_instagram_apify(cfg, existing_names):
    """Поиск через Apify Instagram Profile Scraper."""
    if not APIFY_TOKEN:
        print("  [Instagram] Нет APIFY_TOKEN — пропускаем")
        return []

    ig_queries = cfg.get("queries_instagram", [])
    if not ig_queries:
        # Дефолт, если не указаны
        ig_queries = [
            cfg.get("title", "").split("/")[0].strip() if "Студия" not in cfg.get("title", "") else "косметология",
        ]

    print("  [Instagram] Apify Search...")
    try:
        from apify_client import ApifyClient
    except ImportError:
        print("    apify-client не установлен — пропускаем")
        return []

    client = ApifyClient(token=APIFY_TOKEN)
    found = []

    for query in ig_queries:
        print(f"    Поиск: {query}")
        try:
            from datetime import timedelta
            run = client.actor("apify/instagram-search-scraper").call(
                run_input={
                    "searchType": "user",
                    "search": query,
                    "resultsLimit": 5,
                    "proxy": {"useApifyProxy": True, "apifyProxyGroups": ["RESIDENTIAL"]},
                },
                wait_duration=timedelta(seconds=90),
            )
            dataset = client.dataset(run.default_dataset_id)
            items = dataset.list_items().items

            for item in items:
                username = item.get("username", "")
                full_name = item.get("fullName", "") or username
                followers = item.get("followerCount", 0) or 0
                posts = item.get("postCount", 0) or 0
                bio = item.get("biography", "") or ""
                is_biz = item.get("isBusinessAccount", False)

                if followers < 100 or not is_biz:
                    continue
                if full_name.lower() in existing_names:
                    continue
                if not is_relevant(full_name, bio, cfg):
                    continue

                url = f"https://www.instagram.com/{username}/"
                ss = fmt_subs(followers)
                act = f"~{posts} постов" if posts else "—"

                found.append({
                    "name": f"{full_name} (@{username})",
                    "category": "Прямой — косметолог/блогер",
                    "links": url,
                    "subscribers": f"{ss} (IG)",
                    "positioning": bio[:250] if bio else "Instagram-блогер",
                    "services": "Косметология",
                    "price_segment": "—",
                    "strengths": f"Instagram-блогер, {ss} подписчиков. {bio[:200]}".strip()[:300],
                    "weaknesses": "—",
                    "tov": "—",
                    "audience": "Женщины 20–45",
                    "activity": act,
                    "formats": "Instagram (Reels, Stories)",
                    "threat_level": "—",
                    "borrow": "—",
                    "conclusion": "Найден через Apify Instagram.",
                })
                existing_names.add(full_name.lower())

        except Exception as e:
            print(f"    ERR: {e}")

    return dedup(found)


# ═══════════════════════════════════════════════════
#  MAIN
# ═══════════════════════════════════════════════════


def main():
    parser = argparse.ArgumentParser(description="Мульти-клиентский поиск конкурентов")
    parser.add_argument("--client", "-c", help=f"Имя профиля клиента: {', '.join(list_clients())}")
    parser.add_argument("--dry-run", action="store_true", help="Только stdout, без записи в Sheets")
    parser.add_argument("--list-clients", action="store_true", help="Список доступных клиентов")
    args = parser.parse_args()

    if args.list_clients:
        clients = list_clients()
        print("Доступные клиенты:")
        for c in clients:
            print(f"  • {c}")
        return

    # ── Загружаем профиль ──
    if args.client:
        cfg = load_client(args.client)
        if "error" in cfg:
            print(f"❌ {cfg['error']}")
            sys.exit(1)

        sheet_id = cfg.get("sheet_id") or os.getenv("SHEET_ID")
        sheet_tab = cfg.get("sheet_tab") or os.getenv("SHEET_TAB", "Отчёт по конкурентам")
        client_title = cfg.get("title") or cfg["name"]
        enabled_sources = cfg.get("sources", ["brave", "youtube", "vk"])
        print(f"\n📋 Клиент: {client_title}")
        print(f"   Источники: {', '.join(enabled_sources)}")
        print(f"   Sheets: {sheet_id}/{sheet_tab}")
    else:
        # Legacy mode — из .env
        cfg = {}
        sheet_id = os.getenv("SHEET_ID")
        sheet_tab = os.getenv("SHEET_TAB", "Отчёт по конкурентам")
        client_title = "Конкуренты (legacy)"
        enabled_sources = ["brave", "youtube"]
        print("\n📋 Legacy mode (без профиля)")

    dry_run = args.dry_run

    print("=" * 60)
    print(f"  {client_title}")
    print(f"  {datetime.now().strftime('%Y-%m-%d %H:%M')}")
    print(f"  fact-check L2={FACT_CHECK_LEVEL2} L3={FACT_CHECK_LEVEL3} strict={FACT_CHECK_STRICT}")
    print(f"  dry-run={dry_run}")
    print("=" * 60)

    # 1. Читаем существующие записи
    print("\n1. Существующие записи...")
    existing_links, existing_names = set(), set()
    if sheet_id:
        try:
            existing_links, existing_names = get_existing(sheet_id, sheet_tab)
            print(f"   Ссылок: {len(existing_links)}, Названий: {len(existing_names)}")
        except Exception as e:
            print(f"   Нет доступа к Sheets: {e}")
            print("   Продолжаем без дедупликации")

    # 2-5. Источники
    all_new = []
    source_map = {
        "brave": ("Brave", lambda: from_brave(cfg, existing_links, existing_names)),
        "youtube": ("YouTube", lambda: from_youtube(cfg, existing_links, existing_names)),
        "vk": ("VK", lambda: from_vk(cfg, existing_links, existing_names)),
        "instagram": ("Instagram", lambda: from_instagram_apify(cfg, existing_names)),
    }

    for i, (skey, (sname, sfunc)) in enumerate(source_map.items(), start=2):
        if skey not in enabled_sources:
            print(f"\n{i}. {sname} — выключен в профиле")
            continue
        print(f"\n{i}. {sname}...")
        results = sfunc()
        all_new.extend(results)
        print(f"   → {len(results)} новых")

    # 6. Итого
    total_unique = dedup(all_new)
    print(f"\n{'=' * 60}")
    print(f"  ИТОГО: {len(total_unique)} новых")
    print(f"{'=' * 60}")

    for item in total_unique:
        item.setdefault("fact_check", "—")

    # 7. Запись в Google Sheets
    if total_unique and sheet_id and not dry_run:
        print(f"\n{len(source_map) + 1}. Запись в Google Sheets...")
        written = write_results(sheet_id, sheet_tab, total_unique)
        print(f"  ✅ Записано строк: {written}")
    elif total_unique and dry_run:
        print("\n  (dry-run) Запись пропущена")
    elif total_unique and not sheet_id:
        print("\n  SHEET_ID не задан — данные только в stdout")
    else:
        print("\n  ✅ Новых не найдено")

    # 8. Вывод
    if total_unique:
        print(f"\n  Топ найденных ({len(total_unique)}):")
        for item in total_unique[:20]:
            subs = item.get("subscribers", "")
            links = item.get("links", "")
            print(f"    • {item['name'][:40]:40s} | {subs:14s} | {links[:45]}")
        if len(total_unique) > 20:
            print(f"    ... и еще {len(total_unique) - 20}")

    print()


if __name__ == "__main__":
    main()
