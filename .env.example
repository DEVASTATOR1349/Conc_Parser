# === API ключи ===
# Brave Search (бесплатно 2000 запросов/мес)
BRAVE_API_KEY=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Apify (Instagram)
APIFY_API_TOKEN=
APIFY_API_TOKEN_BACKUP=

# OpenRouter (AI-анализ конкурентов)
OPENROUTER_API_KEY=

# === Google Sheets (опционально — без неё dry-run) ===
# ИЛИ путь к JSON-файлу сервисного аккаунта:
# GOOGLE_APPLICATION_CREDENTIALS=./service_account.json
# ИЛИ строка с JSON:
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

SHEET_ID=1zVNwBX7e8FIZ-0bP7qU2UTbueXrukoev0NbSCS9EwHQ
SHEET_TAB=Отчёт по конкурентам

# === Факт-чекинг ===
# L2: проверка сайта HEAD-запросами (true/false)
FACT_CHECK_LEVEL2=true
# L3: AI-верификация через OpenRouter (false = не тратим токены)
FACT_CHECK_LEVEL3=false
# strict = true: uncertain результаты без AI не пропускать
FACT_CHECK_STRICT=true

# === Настройки ===
TZ=Europe/Moscow
